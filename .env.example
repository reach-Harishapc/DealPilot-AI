# ==============================================================================
# DealPilot Enterprise - Production & Live Connector Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE LLM / FOUNDATION MODEL ENGINES
# ------------------------------------------------------------------------------
# Google Gemini API (Configured & Live: used for pitch synthesis & Coach AI)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# OpenAI API (Optional backup engine for GPT-4o models)
OPENAI_API_KEY=sk-...

# Anthropic Claude API (Alternative model provider)
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------------------------
# 2. CRM CONNECTORS (Pipeline & Deal Source of Truth)
# ------------------------------------------------------------------------------
# Salesforce (Connected App with OAuth2 / REST API)
SALESFORCE_CLIENT_ID=your_salesforce_consumer_key
SALESFORCE_CLIENT_SECRET=your_salesforce_consumer_secret
SALESFORCE_INSTANCE_URL=https://yourcompany.my.salesforce.com
SALESFORCE_REFRESH_TOKEN=your_refresh_token_here

# HubSpot (Private App Access Token)
HUBSPOT_ACCESS_TOKEN=pat-na2-dfc0-475c-48dc-9d18-589fba5b5533

# ------------------------------------------------------------------------------
# 3. CALENDAR & MEETING PIPELINE (Detect Upcoming Executive Calls)
# ------------------------------------------------------------------------------
# Google Workspace / Google Calendar API
GOOGLE_CALENDAR_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_oauth_client_secret

# Microsoft 365 / Outlook (Microsoft Graph API)
MICROSOFT_GRAPH_CLIENT_ID=your_azure_app_id
MICROSOFT_GRAPH_CLIENT_SECRET=your_azure_client_secret
MICROSOFT_GRAPH_TENANT_ID=your_azure_tenant_id

# ------------------------------------------------------------------------------
# 4. EXTERNAL ACCOUNT SIGNALS & PROSPECT INTELLIGENCE
# ------------------------------------------------------------------------------
# Real-Time Web & News Trigger Search (10-K Filings, Mergers, Supply Disruptions)
TAVILY_API_KEY=tvly-...
# OR
SERPER_API_KEY=your_serper_api_key

# Stakeholder & Contact Enrichment (Apollo / ZoomInfo)
APOLLO_API_KEY=your_apollo_api_key
ZOOMINFO_API_KEY=your_zoominfo_api_key

# SEC EDGAR Financial Filings API (Free or sec-api.io)
SEC_API_KEY=your_sec_api_key_here

# ------------------------------------------------------------------------------
# 5. CONVERSATION INTELLIGENCE (Post-Call Objections & Transcripts)
# ------------------------------------------------------------------------------
# Gong.io API
GONG_ACCESS_KEY=your_gong_access_key
GONG_ACCESS_KEY_SECRET=your_gong_access_key_secret

# ------------------------------------------------------------------------------
# 6. EXECUTIVE OUTBOUND EMAIL (Follow-up Dispatches)
# ------------------------------------------------------------------------------
# Resend or SendGrid for executive email delivery
RESEND_API_KEY=re_...
FROM_EMAIL=david.miller@dealpilot.ai

# ------------------------------------------------------------------------------
# 7. SERVER & DEPLOYMENT PORTS
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=development
